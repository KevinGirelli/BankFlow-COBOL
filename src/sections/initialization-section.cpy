       INITIALIZATION-SECTION SECTION.
       CONFIGURE-ENVIRONMENT.
           PERFORM RESOLVE-DIRECTORIES
           PERFORM BUILD-PATHS
           PERFORM LOAD-LOG-CONFIG
           PERFORM INITIALIZE-FILES
           PERFORM OPEN-LOG-FILE
           IF WS-LOG-OPEN-FLAG = "Y"
               PERFORM LOG-CLEAR
               MOVE "SYSTEM" TO WS-LOG-TYPE
               MOVE "START" TO WS-LOG-STATUS-TEXT
               MOVE 1 TO WS-LOG-POINTER
               STRING "session started" DELIMITED BY SIZE
                      INTO WS-LOG-MESSAGE
                      WITH POINTER WS-LOG-POINTER
               END-STRING
               PERFORM LOG-WRITE
           END-IF
           PERFORM METRICS-INITIALIZE
           PERFORM INDEX-INITIALIZE.

       RESOLVE-DIRECTORIES.
           MOVE DEFAULT-DATA-DIR TO WS-DATA-DIR
           MOVE DEFAULT-REPORT-DIR TO WS-REPORT-DIR
           PERFORM LOAD-DATA-DIR-FROM-ENV
           PERFORM LOAD-REPORT-DIR-FROM-ENV.

       LOAD-DATA-DIR-FROM-ENV.
           MOVE SPACES TO WS-DIR-WORK
           ACCEPT WS-DIR-WORK FROM ENVIRONMENT "BANKFLOW_DATA_DIR"
           IF FUNCTION TRIM(WS-DIR-WORK TRAILING) NOT = SPACE
               MOVE FUNCTION TRIM(WS-DIR-WORK TRAILING) TO WS-DATA-DIR
           END-IF.

       LOAD-REPORT-DIR-FROM-ENV.
           MOVE SPACES TO WS-DIR-WORK
           ACCEPT WS-DIR-WORK FROM ENVIRONMENT "BANKFLOW_REPORT_DIR"
           IF FUNCTION TRIM(WS-DIR-WORK TRAILING) NOT = SPACE
               MOVE FUNCTION TRIM(WS-DIR-WORK TRAILING) TO WS-REPORT-DIR
           END-IF.

       LOAD-LOG-CONFIG.
           MOVE DEFAULT-LOG-FILE TO WS-LOG-PATH
           MOVE SPACES TO WS-DIR-WORK
           ACCEPT WS-DIR-WORK FROM ENVIRONMENT "BANKFLOW_LOG_FILE"
           IF FUNCTION TRIM(WS-DIR-WORK TRAILING) NOT = SPACE
               MOVE FUNCTION TRIM(WS-DIR-WORK TRAILING) TO WS-LOG-PATH
           END-IF
           MOVE FUNCTION LENGTH(
                    FUNCTION TRIM(WS-LOG-PATH TRAILING))
               TO WS-DIR-LENGTH
           ADD 1 TO WS-DIR-LENGTH
           IF WS-DIR-LENGTH > LENGTH OF WS-LOG-PATH
               MOVE LENGTH OF WS-LOG-PATH TO WS-DIR-LENGTH
           END-IF
           MOVE X"00" TO WS-LOG-PATH(WS-DIR-LENGTH:1)
           MOVE SPACES TO WS-DIR-WORK
           ACCEPT WS-DIR-WORK FROM ENVIRONMENT "BANKFLOW_VERBOSE"
           IF FUNCTION UPPER-CASE(
                 FUNCTION TRIM(WS-DIR-WORK TRAILING)) = "Y"
                OR FUNCTION TRIM(WS-DIR-WORK TRAILING) = "1"
                OR FUNCTION UPPER-CASE(
                    FUNCTION TRIM(WS-DIR-WORK TRAILING)) = "ON"
               MOVE "Y" TO WS-VERBOSE-FLAG
           END-IF.

       BUILD-PATHS.
           PERFORM BUILD-CLIENT-PATH
           PERFORM BUILD-ACCOUNT-PATH
           PERFORM BUILD-TRANSACTION-PATH
           PERFORM BUILD-REPORT-PATH.

       BUILD-CLIENT-PATH.
           MOVE CLIENT-FILE-NAME TO WS-FILENAME
           PERFORM GENERATE-DATA-PATH
           MOVE WS-PATH-BUILD TO WS-CLIENT-PATH
           MOVE FUNCTION LENGTH(
                    FUNCTION TRIM(WS-CLIENT-PATH TRAILING))
               TO WS-DIR-LENGTH
           ADD 1 TO WS-DIR-LENGTH
           IF WS-DIR-LENGTH > LENGTH OF WS-CLIENT-PATH
               MOVE LENGTH OF WS-CLIENT-PATH TO WS-DIR-LENGTH
           END-IF
           MOVE X"00" TO WS-CLIENT-PATH(WS-DIR-LENGTH:1).

       BUILD-ACCOUNT-PATH.
           MOVE ACCOUNT-FILE-NAME TO WS-FILENAME
           PERFORM GENERATE-DATA-PATH
           MOVE WS-PATH-BUILD TO WS-ACCOUNT-PATH
           MOVE FUNCTION LENGTH(
                    FUNCTION TRIM(WS-ACCOUNT-PATH TRAILING))
               TO WS-DIR-LENGTH
           ADD 1 TO WS-DIR-LENGTH
           IF WS-DIR-LENGTH > LENGTH OF WS-ACCOUNT-PATH
               MOVE LENGTH OF WS-ACCOUNT-PATH TO WS-DIR-LENGTH
           END-IF
           MOVE X"00" TO WS-ACCOUNT-PATH(WS-DIR-LENGTH:1).

       BUILD-TRANSACTION-PATH.
           MOVE TRANSACTION-FILE-NAME TO WS-FILENAME
           PERFORM GENERATE-DATA-PATH
           MOVE WS-PATH-BUILD TO WS-TRANSACTION-PATH
           MOVE FUNCTION LENGTH(
                    FUNCTION TRIM(WS-TRANSACTION-PATH TRAILING))
               TO WS-DIR-LENGTH
           ADD 1 TO WS-DIR-LENGTH
           IF WS-DIR-LENGTH > LENGTH OF WS-TRANSACTION-PATH
               MOVE LENGTH OF WS-TRANSACTION-PATH TO WS-DIR-LENGTH
           END-IF
           MOVE X"00" TO WS-TRANSACTION-PATH(WS-DIR-LENGTH:1).

       BUILD-REPORT-PATH.
           MOVE REPORT-FILE-NAME TO WS-FILENAME
           PERFORM GENERATE-REPORT-PATH
           MOVE WS-PATH-BUILD TO WS-REPORT-PATH
           MOVE FUNCTION LENGTH(
                    FUNCTION TRIM(WS-REPORT-PATH TRAILING))
               TO WS-DIR-LENGTH
           ADD 1 TO WS-DIR-LENGTH
           IF WS-DIR-LENGTH > LENGTH OF WS-REPORT-PATH
               MOVE LENGTH OF WS-REPORT-PATH TO WS-DIR-LENGTH
           END-IF
           MOVE X"00" TO WS-REPORT-PATH(WS-DIR-LENGTH:1).

       GENERATE-DATA-PATH.
           MOVE FUNCTION TRIM(WS-DATA-DIR TRAILING) TO WS-DIR-WORK
           IF WS-DIR-WORK = SPACES
               MOVE DEFAULT-DATA-DIR TO WS-DIR-WORK
           END-IF
           MOVE FUNCTION TRIM(WS-DIR-WORK TRAILING) TO WS-DIR-WORK
           MOVE SPACES TO WS-PATH-BUILD
           MOVE 1 TO WS-STRING-POINTER
           STRING FUNCTION TRIM(WS-DIR-WORK TRAILING) DELIMITED BY SIZE
               INTO WS-PATH-BUILD
               WITH POINTER WS-STRING-POINTER
           END-STRING
           COMPUTE WS-DIR-LENGTH =
               FUNCTION LENGTH(
                   FUNCTION TRIM(WS-PATH-BUILD TRAILING))
           IF WS-DIR-LENGTH > 0
               MOVE WS-PATH-BUILD(WS-DIR-LENGTH:1) TO WS-LAST-CHAR
               IF WS-LAST-CHAR NOT = "/"
                   STRING "/" DELIMITED BY SIZE
                       INTO WS-PATH-BUILD
                       WITH POINTER WS-STRING-POINTER
                   END-STRING
               END-IF
           END-IF
           STRING FUNCTION TRIM(WS-FILENAME TRAILING) DELIMITED BY SIZE
               INTO WS-PATH-BUILD
               WITH POINTER WS-STRING-POINTER
           END-STRING.

       GENERATE-REPORT-PATH.
           MOVE FUNCTION TRIM(WS-REPORT-DIR TRAILING) TO WS-DIR-WORK
           IF WS-DIR-WORK = SPACES
               MOVE DEFAULT-REPORT-DIR TO WS-DIR-WORK
           END-IF
           MOVE FUNCTION TRIM(WS-DIR-WORK TRAILING) TO WS-DIR-WORK
           MOVE SPACES TO WS-PATH-BUILD
           MOVE 1 TO WS-STRING-POINTER
           STRING FUNCTION TRIM(WS-DIR-WORK TRAILING) DELIMITED BY SIZE
               INTO WS-PATH-BUILD
               WITH POINTER WS-STRING-POINTER
           END-STRING
           COMPUTE WS-DIR-LENGTH =
               FUNCTION LENGTH(
                   FUNCTION TRIM(WS-PATH-BUILD TRAILING))
           IF WS-DIR-LENGTH > 0
               MOVE WS-PATH-BUILD(WS-DIR-LENGTH:1) TO WS-LAST-CHAR
               IF WS-LAST-CHAR NOT = "/"
                   STRING "/" DELIMITED BY SIZE
                       INTO WS-PATH-BUILD
                       WITH POINTER WS-STRING-POINTER
                   END-STRING
               END-IF
           END-IF
           STRING FUNCTION TRIM(WS-FILENAME TRAILING) DELIMITED BY SIZE
               INTO WS-PATH-BUILD
               WITH POINTER WS-STRING-POINTER
           END-STRING.

       INITIALIZE-FILES.
           PERFORM ENSURE-CLIENT-FILE
           PERFORM ENSURE-ACCOUNT-FILE
           PERFORM ENSURE-TRANSACTION-FILE
           PERFORM ENSURE-REPORT-FILE
           PERFORM ENSURE-LOG-FILE.

       ENSURE-CLIENT-FILE.
           OPEN I-O CLIENT-FILE
           EVALUATE WS-CLIENT-STATUS
               WHEN "00" CONTINUE
               WHEN "05" CONTINUE
               WHEN "35"
                   OPEN OUTPUT CLIENT-FILE
                   MOVE "00" TO WS-CLIENT-STATUS
                   CLOSE CLIENT-FILE
                   OPEN I-O CLIENT-FILE
               WHEN OTHER
                   DISPLAY "Error accessing clients.dat STATUS: "
                       WS-CLIENT-STATUS
           END-EVALUATE
           CLOSE CLIENT-FILE
           MOVE "00" TO WS-CLIENT-STATUS.

       ENSURE-ACCOUNT-FILE.
           OPEN I-O ACCOUNT-FILE
           EVALUATE WS-ACCOUNT-STATUS
               WHEN "00" CONTINUE
               WHEN "05" CONTINUE
               WHEN "35"
                   OPEN OUTPUT ACCOUNT-FILE
                   MOVE "00" TO WS-ACCOUNT-STATUS
                   CLOSE ACCOUNT-FILE
                   OPEN I-O ACCOUNT-FILE
               WHEN OTHER
                   DISPLAY "Error accessing accounts.dat STATUS: "
                       WS-ACCOUNT-STATUS
           END-EVALUATE
           CLOSE ACCOUNT-FILE
           MOVE "00" TO WS-ACCOUNT-STATUS.

       ENSURE-TRANSACTION-FILE.
           OPEN I-O TRANSACTION-FILE
           EVALUATE WS-TRANSACTION-STATUS
               WHEN "00" CONTINUE
               WHEN "05" CONTINUE
               WHEN "35"
                   OPEN OUTPUT TRANSACTION-FILE
                   MOVE "00" TO WS-TRANSACTION-STATUS
                   CLOSE TRANSACTION-FILE
                   OPEN I-O TRANSACTION-FILE
               WHEN OTHER
                   DISPLAY "Error accessing transactions.dat STATUS: "
                       WS-TRANSACTION-STATUS
           END-EVALUATE
           CLOSE TRANSACTION-FILE
           MOVE "00" TO WS-TRANSACTION-STATUS.

       ENSURE-REPORT-FILE.
           OPEN OUTPUT REPORT-FILE
           MOVE WS-LINE-SEPARATOR TO REPORT-RECORD
           WRITE REPORT-RECORD
           IF WS-REPORT-STATUS NOT = "00"
               DISPLAY "Warning: unable to initialize report. STATUS: "
                   WS-REPORT-STATUS
           END-IF
           CLOSE REPORT-FILE
           MOVE "00" TO WS-REPORT-STATUS.

       ENSURE-LOG-FILE.
           MOVE "00" TO WS-LOG-STATUS
           OPEN EXTEND LOG-FILE
           IF WS-LOG-STATUS = "35"
               OPEN OUTPUT LOG-FILE
               MOVE "00" TO WS-LOG-STATUS
               CLOSE LOG-FILE
               OPEN EXTEND LOG-FILE
           END-IF
           IF WS-LOG-STATUS NOT = "00"
               DISPLAY "Warning: unable to initialize log. STATUS: "
                   WS-LOG-STATUS
           END-IF
           CLOSE LOG-FILE
           MOVE "00" TO WS-LOG-STATUS.

